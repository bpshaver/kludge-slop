#!/bin/bash
# Opens a zellij floating pane running `hunk diff` scoped to the given files.
#
#   hunk-pane src/foo.py src/bar.py
#   hunk-pane --staged src/foo.py
#   hunk-pane --hunk-arg --mode=stack src/foo.py
#   hunk-pane --capture /tmp/review.json src/foo.py
#
# A hunk session lives only as long as its TUI: comments vanish the moment the
# pane closes. --capture polls the live session and keeps the last snapshot on
# disk, so an agent can read the comments after you have quit.
#
# The pane opens in the tab of the pane that ran this script, not the tab the
# user happens to be looking at, so a background agent cannot cover someone
# else's work. Tell the user which tab it landed in; the script prints it.
#
# Zellij's mode is left alone. Locked mode is per-client, not per-tab, so
# locking would take the keyboard away from the user wherever they happen to be
# — including tabs that have nothing to do with this pane. The cost is that
# zellij's Ctrl+s (scroll mode) still shadows hunk's Ctrl+S (save note draft),
# which hunk will not let you remap: press Ctrl+G inside the pane to lock by
# hand if you need it.
#
# Flags (consumed by this script, everything else is a file path):
#   --staged             review staged changes instead of the working tree
#   --watch              auto-reload the pane when the diff changes
#   --target REF         diff against a ref/revset instead of the working tree
#   --hunk-arg ARG       pass ARG through to `hunk diff` (repeatable)
#   --name NAME          floating pane title (default: hunk <first file>)
#   --width/--height N   floating pane size, e.g. 90% or 120 (default 90%/85%)
#   --hold               keep the pane open after hunk exits
#   --near-current-pane  open in this pane's own tab (the default)
#   --follow-focus       open in whatever tab the user is looking at instead
#   --capture FILE       mirror the session's comments to FILE while it lives
#   --capture-every SECS poll interval for --capture (default 2)
#   --dry-run            print the zellij command instead of running it

set -u

hunk_args=()
files=()
target=''
pane_name=''
width='90%'
height='85%'
close_on_exit=1
dry_run=0
capture_file=''
capture_every=2
near_current=1

while [ $# -gt 0 ]; do
  case $1 in
    --staged | --cached | --watch | --exclude-untracked)
      hunk_args+=("$1"); shift ;;
    --target) target=${2:-}; shift 2 ;;
    --hunk-arg) hunk_args+=("${2:-}"); shift 2 ;;
    --name) pane_name=${2:-}; shift 2 ;;
    --width) width=${2:-}; shift 2 ;;
    --height) height=${2:-}; shift 2 ;;
    --hold) close_on_exit=0; shift ;;
    --near-current-pane) near_current=1; shift ;;
    --follow-focus) near_current=0; shift ;;
    --capture) capture_file=${2:-}; shift 2 ;;
    --capture-every) capture_every=${2:-2}; shift 2 ;;
    --dry-run) dry_run=1; shift ;;
    -h | --help)
      awk 'NR>1 && /^#/ {sub(/^# ?/, ""); print; next} NR>1 {exit}' "$0"; exit 0 ;;
    --) shift; while [ $# -gt 0 ]; do files+=("$1"); shift; done ;;
    *) files+=("$1"); shift ;;
  esac
done

if [ ${#files[@]} -eq 0 ]; then
  echo "hunk-pane: no files given" >&2
  exit 2
fi

if [ -z "${ZELLIJ:-}" ]; then
  echo "hunk-pane: not inside a zellij session" >&2
  exit 1
fi
command -v zellij >/dev/null 2>&1 || { echo "hunk-pane: zellij not found" >&2; exit 1; }
command -v hunk >/dev/null 2>&1 || { echo "hunk-pane: hunk not found" >&2; exit 1; }

# The pane starts in $PWD, but a caller may pass paths relative to a different
# directory; absolutize what exists on disk so the pathspecs always resolve.
abs_files=()
for f in "${files[@]}"; do
  if [ -e "$f" ]; then
    case $f in
      /*) abs_files+=("$f") ;;
      *) abs_files+=("$PWD/$f") ;;
    esac
  else
    # Deleted file, or a glob pathspec — hand it to hunk/git untouched.
    abs_files+=("$f")
  fi
done

[ -n "$pane_name" ] || pane_name="hunk $(basename "${files[0]}")$([ ${#files[@]} -gt 1 ] && echo " +$((${#files[@]} - 1))")"

cmd=(zellij action new-pane --floating --cwd "$PWD" --name "$pane_name"
     --width "$width" --height "$height")
# Anchor placement to $ZELLIJ_PANE_ID rather than to the client's focus, so the
# pane lands in this agent's tab instead of on top of whatever the user is
# reading. Floating panes belong to a tab too, so this matters for them as well.
[ "$near_current" -eq 1 ] && cmd+=(--near-current-pane)
[ "$close_on_exit" -eq 1 ] && cmd+=(--close-on-exit)
cmd+=(-- hunk diff)
[ -n "$target" ] && cmd+=("$target")
[ ${#hunk_args[@]} -gt 0 ] && cmd+=("${hunk_args[@]}")
cmd+=(-- "${abs_files[@]}")

if [ "$dry_run" -eq 1 ]; then
  printf '%q ' "${cmd[@]}"; printf '\n'
  exit 0
fi

case $capture_every in
  '' | *[!0-9]*) capture_every=2 ;;
esac
[ "$capture_every" -ge 1 ] 2>/dev/null || capture_every=1
if [ -n "$capture_file" ]; then
  case $capture_file in
    /*) : ;;
    *) capture_file="$PWD/$capture_file" ;;
  esac
fi

session_ids() {
  hunk session list --json 2>/dev/null |
    grep -o '"sessionId"[[:space:]]*:[[:space:]]*"[^"]*"' |
    sed 's/.*"\([^"]*\)"$/\1/'
}

# Snapshot the sessions that already exist, so the one this pane spawns can be
# told apart from any other hunk running against the same repo.
before=$(session_ids)

"${cmd[@]}" || exit $?

# A floating pane created in a tab whose floating panes are toggled off is
# created *invisible* — the user navigates there and sees nothing. Toggling is
# per-tab, so this shows them only in the pane's own tab and leaves every other
# tab (and the user's mode) untouched. One lookup serves both this and the
# "which tab" message below.
own_tab_id=''
own_tab=''
if [ "$near_current" -eq 1 ] && [ -n "${ZELLIJ_PANE_ID:-}" ] &&
   command -v jq >/dev/null 2>&1; then
  read -r own_tab_id own_tab <<EOF
$(zellij action list-panes -t -j 2>/dev/null |
  jq -r --argjson p "$ZELLIJ_PANE_ID" \
    'first(.[] | select(.id == $p and (.is_plugin | not))
     | "\(.tab_id) \(.tab_name)") // ""' 2>/dev/null)
EOF
  [ -n "$own_tab_id" ] &&
    zellij action show-floating-panes -t "$own_tab_id" >/dev/null 2>&1
else
  zellij action show-floating-panes >/dev/null 2>&1
fi

# Only --capture needs the session id: it is what the poller watches. Without it
# the user keeps the pane open and you read the live session by hand, so there
# is nothing to wait for here.
sid=''
if [ -n "$capture_file" ]; then
  for _ in $(seq 1 40); do
    for candidate in $(session_ids); do
      case "
$before
" in
        *"
$candidate
"*) : ;;
        *) sid=$candidate; break 2 ;;
      esac
    done
    sleep 0.25
  done

  if [ -z "$sid" ]; then
    echo "hunk-pane: pane opened, but no new hunk session appeared — not capturing" >&2
  else
    # Watch the session until the TUI exits, mirroring its comments to disk. The
    # session dies with the pane, so the file holds the last successful poll —
    # comments written in the final $capture_every seconds can still be missed.
    tmp="$capture_file.tmp.$$"
    (
      deadline=$((SECONDS + 28800))
      while hunk session get "$sid" --json >/dev/null 2>&1; do
        if out=$(hunk session comment list "$sid" --type all --json 2>/dev/null); then
          printf '%s\n' "$out" >"$tmp" 2>/dev/null && mv -f "$tmp" "$capture_file" 2>/dev/null
        fi
        [ "$SECONDS" -ge "$deadline" ] && break
        sleep "$capture_every"
      done
      rm -f "$tmp"
    ) >/dev/null 2>&1 &
    disown 2>/dev/null || true
  fi
fi

parts=''
[ -n "$sid" ] && parts="session $sid"
[ -n "$own_tab" ] && parts="${parts:+$parts -> }pane is in tab \"$own_tab\""
[ -n "$capture_file" ] && parts="${parts:+$parts -> }capturing comments to $capture_file"
echo "hunk-pane: ${parts:-pane opened}" >&2
